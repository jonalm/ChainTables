# The live suite's configuration (ADR-0030). Copy to env/live.env — /env is git-ignored — and
# fill it in; test/live/run.sh reads it (or the file CHAINTABLES_LIVE_ENV names). The values
# belong to a deployment and never to this repository: keep placeholders here.
#
# Every variable of a test that is run is required, region included; nothing is defaulted or
# taken from the shell. Every run leaves objects behind for good (there is no delete verb):
# expire the prefixes below with a lifecycle rule, or keep them. Not on a locked bucket: there
# expiring current versions adds delete markers, which setup-locked-bucket.sh refuses, and its
# bucket policy denies every lifecycle change (ADR-0038, ADR-0042).

# --- test/live/run.sh gateway: a gateway bucket (docs/gateway-setup.md) ---
CHAINTABLES_LIVE_GATEWAY_BUCKET=<bucket>
CHAINTABLES_LIVE_GATEWAY_URL=https://<id>.lambda-url.<region>.on.aws
# the function behind that URL, its name or ARN: the test asserts a direct Invoke is denied
CHAINTABLES_LIVE_GATEWAY_FUNCTION=<function>
CHAINTABLES_LIVE_GATEWAY_REGION=<region>
# a profile `aws configure export-credentials` works for, after `aws sso login --profile <profile>`
CHAINTABLES_LIVE_GATEWAY_PROFILE=<profile>
# a prefix the gateway policy lists the caller under; the test writes under <prefix>/<run>/
CHAINTABLES_LIVE_GATEWAY_PREFIX=<prefix>
# ... and one it does not: the test asserts a chain there is refused
CHAINTABLES_LIVE_GATEWAY_UNLISTED_PREFIX=<prefix>

# --- test/live/run.sh attachments: a LOCKED gateway bucket (gateway/setup-locked-bucket.sh) ---
# Its gateway policy must list the caller under <prefix>/* and under "" (the bucket root), and
# NOT under <prefix> itself: the test asserts a mint of <prefix>/_attachments/<h> is refused and
# one of the root _attachments/<h> is not (ADR-0046). Each run creates a chain under
# <prefix>/<run>/ and stores two attachments there, each retained the bucket's N days plus about
# a day; a locked bucket refuses lifecycle rules, so they stay until then.
CHAINTABLES_LIVE_ATTACHMENTS_BUCKET=<bucket>
CHAINTABLES_LIVE_ATTACHMENTS_URL=https://<id>.lambda-url.<region>.on.aws
CHAINTABLES_LIVE_ATTACHMENTS_REGION=<region>
# any profile `aws configure export-credentials` works for (Identity Center or an IAM user)
CHAINTABLES_LIVE_ATTACHMENTS_PROFILE=<profile>
CHAINTABLES_LIVE_ATTACHMENTS_PREFIX=<prefix>
